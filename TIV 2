local function tweenAirbags(directionLower)
bodyLowered = directionLower
playAudioClip("Airbags")
local duration, elapsed, stepConnection = 2, 0, nil
stepConnection = RunService.Heartbeat:Connect(function(dt)
elapsed = elapsed + dt
local alpha = math.clamp(elapsed / duration, 0, 1)
local ease = TweenService:GetValue(alpha, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local dynamicY = (directionLower and -0.4 or 0) * ease
for _, part in ipairs(getVehicleDescendants()) do
if part:IsA("BasePart") and not isPartInWheelsGroup(part) then
local currentFrame = currentAnimOffsets[part] or CFrame.identity
currentAnimOffsets[part] = CFrame.new(0, dynamicY, 0) * currentFrame.Rotation
end
end
if alpha >= 1 then stepConnection:Disconnect() end
end)
end
