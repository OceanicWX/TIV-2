local MODEL_ID = 18610130072
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local InsertService = game:GetService("InsertService")
local TweenService = game:GetService("TweenService")
local camera = Workspace.CurrentCamera
local localPlayer = Players.LocalPlayer

if not localPlayer or not localPlayer.Character then return end
local rootPart = localPlayer.Character:WaitForChild("HumanoidRootPart")
local backpack = localPlayer:WaitForChild("Backpack")

-- Clear duplicates from previous sessions
for _, old in ipairs(Workspace:GetChildren()) do
    if old.Name == "Model" and old:FindFirstChild("Dominator3") or old.Name == "Dominator3" or old:FindFirstChild("LeftShield") or old.Name == "SpawnedStormInterceptor2" then
        old:Destroy()
    end
end

for _, item in ipairs(backpack:GetChildren()) do
    if item.Name == "Vehicle Tool" or item.Name == "Spike Controller" or item.Name == "Camera Toggle" or item.Name == "Airbags Tool" then 
        item:Destroy() 
    end
end

local originalCFrames = {}
local currentVehicle = nil

local driveState = {
    shieldsLowered = false, isTweening = false, spikesRaised = false, 
    isTweeningSpikes = false, viewingTurret = false, bodyLowered = false, isTweeningBody = false
}

local AUDIO_IDS = {
    Airbags = "rbxassetid://113736821753793",
    SideFlaps = "rbxassetid://95305655357721",
    FrontFlap = "rbxassetid://86935742939752",
    SideSpikes = "rbxassetid://118063677309726",
    BackSpikes = "rbxassetid://77403948691780"
}

local function playAudioClip(audioName)
    local soundId = AUDIO_IDS[audioName]
    if not soundId then return end
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = 1
    sound.Parent = rootPart
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
    return sound
end

-- Direct Assignment Loading Framework
local success, objects = pcall(function() return game:GetObjects("assetid=" .. MODEL_ID) end)
if success and objects then
    if typeof(objects) == "Instance" then currentVehicle = objects elseif typeof(objects) == "table" and #objects > 0 then currentVehicle = objects end
end
if not currentVehicle then
    pcall(function()
        local collection = InsertService:LoadAsset(MODEL_ID)
        currentVehicle = collection:FindFirstChildOfClass("Model") or collection:GetChildren()
    end)
end
if not currentVehicle then warn("Asset transmission timeout.") return end

if typeof(currentVehicle) == "table" then
    local container = Instance.new("Model", Workspace)
    container.Name = "SpawnedStormInterceptor2"
    for _, item in ipairs(currentVehicle) do if typeof(item) == "Instance" then item.Parent = container end end
    currentVehicle = container
else
    currentVehicle.Name, currentVehicle.Parent = "SpawnedStormInterceptor2", Workspace
end

for _, i in ipairs(currentVehicle:GetDescendants()) do if i:IsA("Light") then i:Destroy() end end
for _, p in ipairs(currentVehicle:GetDescendants()) do if p:IsA("BasePart") then p.Anchored, p.CanCollide = true, true end end

-- Bounding-Box Ground Positioning Drop Pass
local forwardVector = rootPart.CFrame.LookVector
local flatForward = Vector3.new(forwardVector.X, 0, forwardVector.Z).Unit
local spawnTargetPos = rootPart.Position + (flatForward * 14)
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
raycastParams.FilterInstances = {localPlayer.Character, currentVehicle}
local raycastResult = Workspace:Raycast(spawnTargetPos + Vector3.new(0, 20, 0), Vector3.new(0, -40, 0), raycastParams)
local finalPosition = spawnTargetPos
if raycastResult then finalPosition = raycastResult.Position end

local lookCFrame = CFrame.lookAt(finalPosition, finalPosition + flatForward)
local _, boundingSize = currentVehicle:GetBoundingBox()
currentVehicle:PivotTo(lookCFrame * CFrame.new(0, boundingSize.Y / 2, 0))

for _, part in ipairs(currentVehicle:GetDescendants()) do
    if part:IsA("BasePart") then originalCFrames[part] = part.CFrame end
end

_G.D2BackupCore = {
    Mdl = currentVehicle, Orig = originalCFrames, State = driveState, PlayA = playAudioClip, Backpack = backpack
}
local d = _G.D2BackupCore
if not d then return end
local Workspace, TweenService = game:GetService("Workspace"), game:GetService("TweenService")
local mdl, originalCFrames, driveState, playAudioClip, backpack = d.Mdl, d.Orig, d.State, d.PlayA, d.Backpack

local vehicleTool = Instance.new("Tool", backpack) vehicleTool.Name = "Vehicle Tool" vehicleTool.RequiresHandle = false
local spikeTool = Instance.new("Tool", backpack) spikeTool.Name = "Spike Controller" spikeTool.RequiresHandle = false

local function tweenVehicleGroup(partNames, directionLower, soundKeyToPlay)
    local tweenInfo = TweenInfo.new(6, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local completedSignal = Instance.new("BindableEvent")
    local activeTweens = 0
    if soundKeyToPlay then playAudioClip(soundKeyToPlay) end
    for _, part in ipairs(mdl:GetDescendants()) do
        if part:IsA("BasePart") and table.find(partNames, part.Name) then
            local targetOffset = directionLower and -1.9 or 0
            if part.Name == "LeftSpike" or part.Name == "RightSpike" then targetOffset = -targetOffset end
            local baseCFrame = originalCFrames[part] or part.CFrame
            local targetCFrame = baseCFrame * CFrame.new(0, targetOffset, 0)
            if driveState.bodyLowered then
                local currentRot = targetCFrame - targetCFrame.Position
                targetCFrame = CFrame.new(targetCFrame.Position + Vector3.new(0, -0.4, 0)) * currentRot
            end
            local tween = TweenService:Create(part, tweenInfo, {CFrame = targetCFrame})
            activeTweens = activeTweens + 1
            tween.Completed:Connect(function() activeTweens = activeTweens - 1 if activeTweens <= 0 then completedSignal:Fire() end end)
            tween:Play()
        end
    end
    if activeTweens > 0 then completedSignal.Event:Wait() completedSignal:Destroy() end
end

vehicleTool.Activated:Connect(function()
    if driveState.isTweening then return end driveState.isTweening = true
    task.spawn(function()
        if not driveState.shieldsLowered then
            driveState.shieldsLowered = true
            tweenVehicleGroup({"LeftShield", "LeftFlap", "LeftSpike"}, true, "SideFlaps")
            tweenVehicleGroup({"RightShield", "RightFlap", "RightSpike"}, true, "SideFlaps")
            tweenVehicleGroup({"FrontField", "FrontFlap", "Shield2", "FRI", "FLI"}, true, "FrontFlap")
        else
            tweenVehicleGroup({"FrontField", "FrontFlap", "Shield2", "FRI", "FLI"}, false, "FrontFlap")
            tweenVehicleGroup({"RightShield", "RightFlap", "RightSpike"}, false, "SideFlaps")
            tweenVehicleGroup({"LeftShield", "LeftFlap", "LeftSpike"}, false, "SideFlaps")
            driveState.shieldsLowered = false
        end
        driveState.isTweening = false
    end)
end)

local function tweenSpikeGroup(partNames, directionRaise, soundKeyToPlay, customDuration)
    local tweenInfo = TweenInfo.new(customDuration or 3, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local completedSignal = Instance.new("BindableEvent")
    local activeTweens = 0
    if soundKeyToPlay then playAudioClip(soundKeyToPlay) end
    for _, part in ipairs(mdl:GetDescendants()) do
        if part:IsA("BasePart") and table.find(partNames, part.Name) then
            local targetOffset = 0
            if directionRaise then targetOffset = (part.Name == "BackSpike") and 2.3 or 3.2 end
            local baseCFrame = originalCFrames[part] or part.CFrame
            local targetCFrame = baseCFrame * CFrame.new(0, targetOffset, 0)
            if driveState.bodyLowered then
                local currentRot = targetCFrame - targetCFrame.Position
                targetCFrame = CFrame.new(targetCFrame.Position + Vector3.new(0, -0.4, 0)) * currentRot
            end
            local tween = TweenService:Create(part, tweenInfo, {CFrame = targetCFrame})
            activeTweens = activeTweens + 1
            tween.Completed:Connect(function() activeTweens = activeTweens - 1 if activeTweens <= 0 then completedSignal:Fire() end end)
            tween:Play()
        end
    end
    if activeTweens > 0 then completedSignal.Event:Wait() completedSignal:Destroy() end
end

spikeTool.Activated:Connect(function()
    if driveState.isTweeningSpikes then return end driveState.isTweeningSpikes = true
    task.spawn(function()
        if not driveState.spikesRaised then
            driveState.spikesRaised = true
            tweenSpikeGroup({"LeftSpike", "RightSpike"}, true, "SideSpikes", 7.5)
            tweenSpikeGroup({"BackSpike"}, true, "BackSpikes", 3)
        else
            tweenSpikeGroup({"BackSpike"}, false, "BackSpikes", 3)
            tweenSpikeGroup({"LeftSpike", "RightSpike"}, false, "SideSpikes", 7.5)
            driveState.spikesRaised = false
        end
        driveState.isTweeningSpikes = false
    end)
end)

_G.D2BackupCore.TweenSpikeGroup = tweenSpikeGroup
local d = _G.D2BackupCore
if not d or not d.Mdl then return end
local Workspace, TweenService = game:GetService("Workspace"), game:GetService("TweenService")
local localPlayer = game:GetService("Players").LocalPlayer
local camera = Workspace.CurrentCamera
local mdl, originalCFrames, driveState, playAudioClip, backpack = d.Mdl, d.Orig, d.State, d.PlayA, d.Backpack

local cameraTool = Instance.new("Tool", backpack) cameraTool.Name = "Camera Toggle" cameraTool.RequiresHandle = false
local airbagsTool = Instance.new("Tool", backpack) airbagsTool.Name = "Airbags Tool" airbagsTool.RequiresHandle = false

cameraTool.Activated:Connect(function()
    local character = localPlayer.Character if not character or not character:FindFirstChild("Humanoid") then return end
    if not driveState.viewingTurret then
        local camPart = nil for _, p in ipairs(mdl:GetDescendants()) do if p:IsA("BasePart") and p.Name == "Cam" then camPart = p break end end
        if camPart then camera.CameraType = Enum.CameraType.Custom camera.CameraSubject = camPart driveState.viewingTurret = true end
    else
        camera.CameraType, camera.CameraSubject, driveState.viewingTurret = Enum.CameraType.Custom, character.Humanoid, false
    end
end)

cameraTool.Unequipped:Connect(function()
    local character = localPlayer.Character
    if character and character:FindFirstChild("Humanoid") then camera.CameraType, camera.CameraSubject = Enum.CameraType.Custom, character.Humanoid end
    driveState.viewingTurret = false
end)

local function isPartInWheelsGroup(p)
    local cur = p.Parent while cur and cur ~= Workspace do if cur.Name:lower():find("wheel") then return true end cur = cur.Parent end return false
end

local function tweenAirbags(directionLower)
    local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local completedSignal = Instance.new("BindableEvent")
    local activeTweens = 0 driveState.bodyLowered = directionLower playAudioClip("Airbags")
    for _, part in ipairs(mdl:GetDescendants()) do
        if part:IsA("BasePart") and not isPartInWheelsGroup(part) then
            local isAnimatedMovingPart = table.find({"LeftShield", "LeftFlap", "LeftSpike", "RightShield", "RightFlap", "RightSpike", "FrontField", "FrontFlap", "Shield2", "FRI", "FLI", "BackSpike"}, part.Name) ~= nil
            local airbagOffset = directionLower and -0.4 or 0
            local currentRot = part.CFrame - part.CFrame.Position
            local baseCFrame = originalCFrames[part] or part.CFrame
            local basePos = baseCFrame.Position
            if part.Name == "LeftSpike" or part.Name == "RightSpike" then
                if driveState.spikesRaised then basePos = (baseCFrame * CFrame.new(0, 3.2, 0)).Position end
            elseif part.Name == "BackSpike" then
                if driveState.spikesRaised then basePos = (baseCFrame * CFrame.new(0, 2.3, 0)).Position end
            elseif isAnimatedMovingPart and driveState.shieldsLowered then
                local offsetVal = -1.9 if part.Name == "LeftSpike" or part.Name == "RightSpike" then offsetVal = 1.9 end
                basePos = (baseCFrame * CFrame.new(0, offsetVal, 0)).Position
            end
            local targetCFrame = CFrame.new(basePos + Vector3.new(0, airbagOffset, 0)) * currentRot
            local tween = TweenService:Create(part, tweenInfo, {CFrame = targetCFrame})
            activeTweens = activeTweens + 1
            tween.Completed:Connect(function() activeTweens = activeTweens - 1 if activeTweens <= 0 then completedSignal:Fire() end end)
            tween:Play()
        end
    end
    if activeTweens > 0 then completedSignal.Event:Wait() completedSignal:Destroy() end
end

airbagsTool.Activated:Connect(function()
    if driveState.isTweeningBody then return end driveState.isTweeningBody = true
    task.spawn(function() if not driveState.bodyLowered then tweenAirbags(true) else tweenAirbags(false) end driveState.isTweeningBody = false end)
end)
