if success and loadedObjects then
if typeof(loadedObjects) == "Instance" then
if loadedObjects:IsA("Model") then
actualModel = loadedObjects
else
actualModel = loadedObjects:FindFirstChildOfClass("Model")
end
elseif type(loadedObjects) == "table" then
for _, obj in ipairs(loadedObjects) do
if typeof(obj) == "Instance" then
if obj:IsA("Model") then
actualModel = obj
break
else
local found = obj:FindFirstChildOfClass("Model")
if found then
actualModel = found
break
end
end
end
end
end
end
