local function getSoundDuration(soundKey)
	if soundKey == "FrontFlap" then return AUDIO_DURATIONS.FrontFlap end
	local sound = SoundInstances[soundKey]
	if sound then
		if not sound.IsLoaded then
			pcall(function()
				local startTime = os.clock()
				while not sound.IsLoaded and os.clock() - startTime < 1 do task.wait() end
			end)
		end
		if sound.TimeLength > 0 then return sound.TimeLength end
	end
	return AUDIO_DURATIONS[soundKey] or 4
end

local function playAudio(soundKey)
	local sound = SoundInstances[soundKey]
	if sound then sound:Play() end
end

local function isInsideWheelFolder(object)
	local current = object.Parent
	while current and current ~= Workspace and current ~= game do
		if string.lower(current.Name) == "wheels" then return true end
		current = current.Parent
	end
	return false
end
-- PART 2 OF SCRIPT
local function getOffsets()
	local airbagY = airbagsDeployed and -0.4 or 0
	local flapY = flapsDeployed and -1.9 or 0
	if flapsDeployed and airbagsDeployed then flapY = -1.5 end
	local sideSpikeY = 0
	if spikesDeployed then
		sideSpikeY = airbagsDeployed and -3.1 or -3.5
	elseif flapsDeployed then
		sideSpikeY = airbagsDeployed and -1.5 or -1.9
	end
	return airbagY, flapY, sideSpikeY, spikesDeployed and 2.3 or 0
end

local function tweenComponentToAbsoluteState(partName, duration)
	if not VehicleModel or not VehicleModel.PrimaryPart or not OriginalPrimaryCFrame then return end
	local airbagY, flapY, sideSpikeY, rearSpikeY = getOffsets()
	local tweenInfo = TweenInfo.new(duration or 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	for part, origCFrame in pairs(OriginalCFrameStorage) do
		if part and part.Parent and part.Name == partName then
			part:SetAttribute("IsTweening", true)
			local localOffset = Vector3.zero
			if partName == "LeftFlap" or partName == "LeftShield" or partName == "RightFlap" or partName == "RightShield" or partName == "FrontFlap" or partName == "Shield2" or partName == "FLI" or partName == "FRI" then
				localOffset = Vector3.new(0, flapY, 0)
			elseif partName == "LeftSpike" or partName == "RightSpike" then
				localOffset = Vector3.new(0, -sideSpikeY, 0)
			elseif partName == "BackSpike" then
				localOffset = Vector3.new(0, rearSpikeY, 0)
			end
			
			local modifiedOrigCFrame = (origCFrame * CFrame.new(localOffset)) + Vector3.new(0, airbagY, 0)
			local relativeOffset = OriginalPrimaryCFrame:ToObjectSpace(modifiedOrigCFrame)
			
			local tw = TweenService:Create(part, tweenInfo, { CFrame = VehicleModel.PrimaryPart.CFrame * relativeOffset })
			tw.Completed:Connect(function() part:SetAttribute("IsTweening", nil) end)
			tw:Play()
		end
	end
end

local function applyAbsoluteVehicleState(duration)
	if not VehicleModel or not VehicleModel.PrimaryPart or not OriginalPrimaryCFrame then return end
	local airbagY, flapY, sideSpikeY, rearSpikeY = getOffsets()
	local tweenInfo = TweenInfo.new(duration or 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	for part, origCFrame in pairs(OriginalCFrameStorage) do
		if part and part.Parent and part ~= VehicleModel.PrimaryPart then
			part:SetAttribute("IsTweening", true)
			local localOffset = Vector3.zero
			local worldAirbagOffset = isInsideWheelFolder(part) and Vector3.zero or Vector3.new(0, airbagY, 0)
			
			if part.Name == "LeftFlap" or part.Name == "LeftShield" or part.Name == "RightFlap" or part.Name == "RightShield" or part.Name == "FrontFlap" or part.Name == "Shield2" or part.Name == "FLI" or part.Name == "FRI" then
				localOffset = Vector3.new(0, flapY, 0)
			elseif part.Name == "LeftSpike" or part.Name == "RightSpike" then
				localOffset = Vector3.new(0, -sideSpikeY, 0)
			elseif part.Name == "BackSpike" then
				localOffset = Vector3.new(0, rearSpikeY, 0)
			end
			
			local modifiedOrigCFrame = (origCFrame * CFrame.new(localOffset)) + worldAirbagOffset
			local relativeOffset = OriginalPrimaryCFrame:ToObjectSpace(modifiedOrigCFrame)
			
			local tw = TweenService:Create(part, tweenInfo, { CFrame = VehicleModel.PrimaryPart.CFrame * relativeOffset })
			tw.Completed:Connect(function() part:SetAttribute("IsTweening", nil) end)
			tw:Play()
		end
	end
end

local function exitSeat()
	if not isSeated then return end
	isSeated, screenGui.Enabled = false, false
	driveState.forward, driveState.reverse, driveState.left, driveState.right, driveState.brake, driveState.currentSpeed = false, false, false, false, false, 0
	if playerWeld and playerWeld.Parent then playerWeld:Destroy() end
	playerWeld = nil
	if jumpConnection then jumpConnection:Disconnect() end
	jumpConnection = nil
	
	local character = LocalPlayer.Character
	if character then
		local rootPart, humanoid = character:FindFirstChild("HumanoidRootPart"), character:FindFirstChildOfClass("Humanoid")
		if rootPart and targetSeat then rootPart.CFrame = targetSeat.CFrame * CFrame.new(-6, 2, 0) end
		if humanoid then humanoid.Sit = false end
	end
end

local function enterSeat()
	local character = LocalPlayer.Character
	if not character or isSeated then return end
	local rootPart, humanoid = character:FindFirstChild("HumanoidRootPart"), character:FindFirstChildOfClass("Humanoid")
	
	if rootPart and humanoid and humanoid.Health > 0 and targetSeat then
		isSeated, screenGui.Enabled = true, true
		rootPart.CFrame, humanoid.Sit = targetSeat.CFrame * CFrame.new(0, 1.5, 0), true
		
		playerWeld = Instance.new("WeldConstraint")
		playerWeld.Name, playerWeld.Part0, playerWeld.Part1, playerWeld.Parent = "ForcedLocalSeatLock", targetSeat, rootPart, rootPart
		jumpConnection = humanoid:GetPropertyChangedSignal("Jump"):Connect(function() if humanoid.Jump then exitSeat() end end)
	end
end
-- PART 3 OF SCRIPT
local function initializeVehicle(character)
	if VehicleModel then pcall(function() VehicleModel:Destroy() end) end
	OriginalCFrameStorage, OriginalPrimaryCFrame = {}, nil
	local loadedObjects = nil
	pcall(function() loadedObjects = game:GetObjects("rbxassetid://" .. tostring(CORE_VEHICLE_ID)) end)

	if loadedObjects then
		local rootObject = type(loadedObjects) == "table" and loadedObjects or loadedObjects
		VehicleModel = rootObject:IsA("Model") and rootObject or rootObject:FindFirstChildOfClass("Model") or Instance.new("Model")
	else
		VehicleModel = Instance.new("Model")
	end
	VehicleModel.Name = "DeltaVehicle_Instance"

	for _, desc in ipairs(VehicleModel:GetDescendants()) do
		if desc:IsA("BasePart") then desc.Anchored, desc.CanCollide = true, true end
	end

	local function verifyComponent(name)
		local comp = VehicleModel:FindFirstChild(name, true)
		if not comp then
			comp = Instance.new("Part")
			comp.Name, comp.Size, comp.Anchored, comp.CanCollide, comp.Transparency, comp.Parent = name, Vector3.one, true, false, 1, VehicleModel
		end
		return comp
	end

	local coreComponents = { "LeftFlap", "LeftShield", "LeftSpike", "RightFlap", "RightShield", "RightSpike", "FrontFlap", "Shield2", "BackSpike", "Cam", "FLI", "FRI" }
	for _, name in ipairs(coreComponents) do verifyComponent(name) end

	if not VehicleModel.PrimaryPart then
		VehicleModel.PrimaryPart = VehicleModel:FindFirstChild("HumanoidRootPart", true) or VehicleModel:FindFirstChildOfClass("BasePart") or verifyComponent("HumanoidRootPart")
	end

	for key, assetId in pairs(AUDIO_INDEX) do
		local sound = Instance.new("Sound")
		sound.SoundId, sound.Volume, sound.Parent = assetId, 2.5, VehicleModel.PrimaryPart
		SoundInstances[key] = sound
	end

	local driverSeat = VehicleModel:FindFirstChild("DriveSeat", true) or VehicleModel:FindFirstChild("DriverSeat", true)
	if driverSeat and driverSeat:FindFirstChild("E to enter", true) then pcall(function() driverSeat:FindFirstChild("E to enter", true):Destroy() end) end

	targetSeat = Instance.new("Part")
	targetSeat.Name, targetSeat.Size, targetSeat.BrickColor, targetSeat.Material, targetSeat.Anchored, targetSeat.CanCollide = "CustomIsolatedSeat", Vector3.new(4, 0.5, 4), BrickColor.new("Dark stone grey"), Enum.Material.SmoothPlastic, true, true
	targetSeat.Parent = driverSeat or VehicleModel
	targetSeat.CFrame = driverSeat and (driverSeat.CFrame * CFrame.new(0, -0.4, 0)) or (VehicleModel.PrimaryPart.CFrame * CFrame.new(0, 1.6, 0))
	targetSeat.Touched:Connect(function(hit) if hit.Parent == LocalPlayer.Character then enterSeat() end end)

	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then
		local spawnOrigin = hrp.Position + (hrp.CFrame.LookVector * 14)
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType, raycastParams.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { character, VehicleModel }
		local rayResult = Workspace:Raycast(spawnOrigin + Vector3.new(0, 15, 0), Vector3.new(0, -40, 0), raycastParams)
		
		VehicleModel:PivotTo(CFrame.new(spawnOrigin.X, rayResult and rayResult.Position.Y or spawnOrigin.Y + 1.2, spawnOrigin.Z) * (hrp.CFrame - hrp.Position))
		OriginalPrimaryCFrame = VehicleModel.PrimaryPart.CFrame
		for _, part in ipairs(VehicleModel:GetDescendants()) do
			if part:IsA("BasePart") then OriginalCFrameStorage[part] = part.CFrame end
		end
		VehicleModel.Parent = Workspace
	end
	return true
end

local function stopDriving()
	driveState.forward, driveState.reverse, driveState.left, driveState.right, driveState.brake = false, false, false, false, false
	driveState.currentSpeed = 0
end

local function equipVehicleTool()
	local tool = Instance.new("Tool")
	tool.Name, tool.RequiresHandle = "Vehicle Tool", false

	tool.Activated:Connect(function()
		if isTweening or not VehicleModel then return end
		isTweening = true
		stopDriving()
		flapsDeployed = not flapsDeployed
		local sideFlapDur, frontFlapDur = getSoundDuration("SideFlaps"), getSoundDuration("FrontFlap")

		if flapsDeployed then
			playAudio("SideFlaps")
			tweenComponentToAbsoluteState("LeftFlap", sideFlapDur)
			tweenComponentToAbsoluteState("LeftShield", sideFlapDur)
			tweenComponentToAbsoluteState("LeftSpike", sideFlapDur)
			task.wait(sideFlapDur)
			playAudio("SideFlaps")
			tweenComponentToAbsoluteState("RightFlap", sideFlapDur)
			tweenComponentToAbsoluteState("RightShield", sideFlapDur)
			tweenComponentToAbsoluteState("RightSpike", sideFlapDur)
			task.wait(sideFlapDur)
			playAudio("FrontFlap")
			tweenComponentToAbsoluteState("FrontFlap", frontFlapDur)
			tweenComponentToAbsoluteState("Shield2", frontFlapDur)
			tweenComponentToAbsoluteState("FLI", frontFlapDur)
			tweenComponentToAbsoluteState("FRI", frontFlapDur)
			task.wait(frontFlapDur)
		else
			playAudio("FrontFlap")
			tweenComponentToAbsoluteState("FrontFlap", frontFlapDur)
			tweenComponentToAbsoluteState("Shield2", frontFlapDur)
			tweenComponentToAbsoluteState("FLI", frontFlapDur)
			tweenComponentToAbsoluteState("FRI", frontFlapDur)
			task.wait(frontFlapDur)
			playAudio("SideFlaps")
			tweenComponentToAbsoluteState("RightFlap", sideFlapDur)
			tweenComponentToAbsoluteState("RightShield", sideFlapDur)
			tweenComponentToAbsoluteState("RightSpike", sideFlapDur)
			task.wait(sideFlapDur)
			playAudio("SideFlaps")
			tweenComponentToAbsoluteState("LeftFlap", sideFlapDur)
			tweenComponentToAbsoluteState("LeftShield", sideFlapDur)
			tweenComponentToAbsoluteState("LeftSpike", sideFlapDur)
			task.wait(sideFlapDur)
		end
		isTweening = false
	end)
	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
end
