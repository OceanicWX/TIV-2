local function playAudioClip(audioName, parentInstance)
    if not parentInstance then parentInstance = root end
    local soundId = AUDIO_IDS[audioName]
    if not soundId then return end
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = 1
    sound.Parent = parentInstance
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
    return sound
end

local function startEng()
    if engState ~= "Off" then return end
    engState = "Starting"
    if engineSound then engineSound:Stop() end
    if startupSound then startupSound:Destroy() end
    startupSound = Instance.new("Sound")
    startupSound.SoundId = AUDIO_IDS.Startup
    startupSound.Volume = 2.0
    startupSound.Parent = root
    startupSound:Play()
    if engineSound then engineSound.Volume = 0 engineSound:Play() end
    task.spawn(function()
        local duration, elapsed = 2.5, 0
        while elapsed < duration and engState == "Starting" do
            task.wait(0.05)
            elapsed = elapsed + 0.05
            if startupSound and startupSound.Parent and startupSound.TimePosition >= (duration - 0.8) and engineSound then
                engineSound.Volume = math.clamp(((startupSound.TimePosition - (duration - 0.8)) / 0.8) * 1.8, 0, 1.8)
            end
        end
        if engState == "Starting" then engState = "Running" if engineSound then engineSound.Volume = 1.8 end end
    end)
end

local function stopEng()
    engState = "Off"
    if startupSound then startupSound:Stop() startupSound:Destroy() startupSound = nil end
    task.spawn(function()
        while engineSound and engineSound.Volume > 0 and engState == "Off" do
            engineSound.Volume = math.max(0, engineSound.Volume - 0.2)
            task.wait(0.02)
        end
        if engState == "Off" and engineSound then engineSound:Stop() end
    end)
end

local function exitSeat()
    if not isSeated then return end
    isSeated = false
    stopEng()
    if playerWeld and playerWeld.Parent then playerWeld:Destroy() end
    playerWeld = nil
    if jumpConnection then jumpConnection:Disconnect() end
    jumpConnection = nil
    player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom
    if screenGui then screenGui.Enabled = false end
    if persistentGui then persistentGui.Enabled = false end
    if root and currentVehicle then root.CFrame = currentVehicle:GetPivot() * CFrame.new(-6, 2, 0) end
    local humanoidPart = character:FindFirstChild("Humanoid")
    if humanoidPart then humanoidPart.Sit = false end
end

local function enterSeat()
    if isSeated or not character or not targetSeat then return end
    local humanoidPart = character:FindFirstChild("Humanoid")
    if root and humanoidPart and humanoidPart.Health > 0 then
        isSeated = true
        root.CFrame = targetSeat.CFrame * CFrame.new(0, 1.5, 0)
        humanoidPart.Sit = true
        playerWeld = Instance.new("WeldConstraint", root)
        playerWeld.Name = "ForcedLocalSeatLock"
        playerWeld.Part0 = targetSeat
        playerWeld.Part1 = root
        player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom
        if screenGui then screenGui.Enabled = true end
        if persistentGui then persistentGui.Enabled = true end
        startEng()
        jumpConnection = humanoidPart:GetPropertyChangedSignal("Jump"):Connect(function()
            if humanoidPart.Jump then exitSeat() end
        end)
    end
end

local function lookForSeat(parent)
    for _, desc in ipairs(parent:GetDescendants()) do
        if desc:IsA("BasePart") and (desc.Name == "DriveSeat" or desc.Name == "DriverSeat" or desc.Name == "VehicleSeat") then
            return desc
        end
    end
    return nil
end

local function getVehicleDescendants()
    if not currentVehicle then return {} end
    if typeof(currentVehicle) == "Instance" then return currentVehicle:GetDescendants()
    elseif typeof(currentVehicle) == "table" then
        local descendants = {}
        for _, obj in ipairs(currentVehicle) do
            if typeof(obj) == "Instance" then
                table.insert(descendants, obj)
                for _, desc in ipairs(obj:GetDescendants()) do table.insert(descendants, desc) end
            end
        end
        return descendants
    end
    return {}
end

