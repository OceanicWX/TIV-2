local function spawnVehicle()
    for _, old in ipairs(workspace:GetChildren()) do
        if old.Name == "Model" and old:FindFirstChild("Dominator3") or old.Name == "Dominator3" or old:FindFirstChild("LeftShield") then
            old:Destroy()
        end
    end

    originalCFrames = {}
    shieldsLowered = false
    spikesRaised = false
    viewingTurret = false
    bodyLowered = false
    isTweening = false
    isTweeningSpikes = false
    isTweeningBody = false

    local success, objects = pcall(function() return game:GetObjects(assetId) end)
    local model = nil
    if success and objects then
        if typeof(objects) == "Instance" then model = objects
        elseif typeof(objects) == "table" and #objects > 0 then model = objects[1] or objects end
    end

    if not model then
        local success2, model2 = pcall(function() return game:GetService("InsertService"):LoadAsset(18610130072) end)
        if success2 and model2 then model = model2:FindFirstChildOfClass("Model") or model2 end
    end

    if model then
        if typeof(model) == "table" then
            for _, obj in ipairs(model) do if typeof(obj) == "Instance" then obj.Parent = workspace end end
        else model.Parent = workspace end
        
        currentVehicle = model
        
        local function scanParts(item)
            if typeof(item) == "table" then
                for _, o in ipairs(item) do scanParts(o) end
            elseif typeof(item) == "Instance" then
                for _, part in ipairs(item:GetDescendants()) do
                    if part:IsA("BasePart") then part.Anchored = true part.CanCollide = true end
                end
                local spawnCFrame = root.CFrame * CFrame.new(0, -1.8, -15)
                if item:IsA("Model") then item:PivotTo(spawnCFrame)
                elseif item:IsA("BasePart") then item.CFrame = spawnCFrame end
            end
        end
        scanParts(model)

        local function indexCFrames(item)
            if typeof(item) == "table" then
                for _, o in ipairs(item) do indexCFrames(o) end
            elseif typeof(item) == "Instance" then
                for _, part in ipairs(item:GetDescendants()) do
                    if part:IsA("BasePart") then originalCFrames[part] = part.CFrame end
                end
            end
        end
        indexCFrames(model)

        local driverSeatPart = nil
        if typeof(model) == "Instance" then driverSeatPart = lookForSeat(model) end

        targetSeat = Instance.new("Part")
        targetSeat.Name = "CustomIsolatedSeat"
        targetSeat.Size = Vector3.new(4, 0.5, 4)
        targetSeat.Transparency = 1
        targetSeat.Anchored = true
        targetSeat.CanCollide = true
        targetSeat.Parent = workspace

        if driverSeatPart then targetSeat.CFrame = driverSeatPart.CFrame * CFrame.new(0, -0.3, 0) end

        targetSeat.Touched:Connect(function(hit) if character and hit.Parent == character then enterSeat() end end)

        if engineSound then engineSound:Destroy() end
        engineSound = Instance.new("Sound")
        engineSound.SoundId = AUDIO_IDS.Engine
        engineSound.Volume = 0
        engineSound.Looped = true
        engineSound.Parent = root

        local oldDriveGui = PlayerGui:FindFirstChild("Dominator2DriveUI")
        if oldDriveGui then oldDriveGui:Destroy() end
        local oldPersGui = PlayerGui:FindFirstChild("Dominator2PersistentUI")
        if oldPersGui then oldPersGui:Destroy() end

        screenGui = Instance.new("ScreenGui")
        screenGui.Name = "Dominator2DriveUI"
        screenGui.ResetOnSpawn = false
        screenGui.Parent = PlayerGui
        screenGui.Enabled = false

        persistentGui = Instance.new("ScreenGui")
        persistentGui.Name = "Dominator2PersistentUI"
        persistentGui.ResetOnSpawn = false
        persistentGui.Parent = PlayerGui
        persistentGui.Enabled = false

        local mainUIFrame = Instance.new("Frame", screenGui)
