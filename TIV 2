local function bind(b, k, c)
	b.InputBegan:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
			if isTweening then return end
			if k == "forward" then driveState.reverse = false elseif k == "reverse" then driveState.forward = false end
			driveState[k] = true b.BackgroundTransparency = 0.1 if c then b.TextColor3 = c end
		end
	end)
	b.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			driveState[k] = false b.BackgroundTransparency = 0.4
			if k == "brake" then b.TextColor3 = Color3.fromRGB(220, 60, 60) 
			elseif k == "forward" then b.TextColor3 = Color3.fromRGB(60, 180, 60) 
			elseif k == "reverse" then b.TextColor3 = Color3.fromRGB(245, 245, 245) 
			else b.TextColor3 = Color3.fromRGB(245, 245, 245) end
		end
	end)
end

