targetSeat.BrickColor = BrickColor.new("Dark stone grey") targetSeat.Material = Enum.Material.SmoothPlastic
targetSeat.Anchored = true targetSeat.CanCollide = true
if driverSeat and driverSeat:IsA("BasePart") then targetSeat.Parent = driverSeat targetSeat.CFrame = driverSeat.CFrame * CFrame.new(0, -0.4, 0)
else targetSeat.Parent = VehicleModel targetSeat.Position = VehicleModel.PrimaryPart.Position + Vector3.new(0, 1.6, 0) end
targetSeat.Touched:Connect(function(hit) local char = LocalPlayer.Character if char and hit.Parent == char then enterSeat() end end)
local hrp = character:FindFirstChild("HumanoidRootPart")
if hrp then
local spawnOrigin = hrp.Position + (hrp.CFrame.LookVector * 14)
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude raycastParams.FilterDescendantsInstances = { character, VehicleModel }
local rayResult = Workspace:Raycast(spawnOrigin + Vector3.new(0, 15, 0), Vector3.new(0, -40, 0), raycastParams)
local groundHeight = rayResult and rayResult.Position.Y or spawnOrigin.Y
local finalCFrame = CFrame.new(spawnOrigin.X, groundHeight + 1.2, spawnOrigin.Z) * (hrp.CFrame - hrp.Position)
VehicleModel:PivotTo(finalCFrame)
OriginalPrimaryCFrame = VehicleModel.PrimaryPart.CFrame
for _, part in ipairs(VehicleModel:GetDescendants()) do if part:IsA("BasePart") then OriginalCFrameStorage[part] = part.CFrame end end
VehicleModel.Parent = Workspace
end
updateModelLights(lightsActive)
return true
end
local function equipSitTeleportTool()
local tool = Instance.new("Tool") tool.Name = "Sit(TIV2)" tool.RequiresHandle = false
tool.Activated:Connect(function() if targetSeat and targetSeat.Parent then enterSeat() end end)
tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
end
RunService.Heartbeat:Connect(function(dt)
if not VehicleModel or not VehicleModel.Parent or not VehicleModel.PrimaryPart or not isSeated or not OriginalPrimaryCFrame then return end
local prim = VehicleModel.PrimaryPart
if locked() then
driveState.forward, driveState.reverse, driveState.left, driveState.right, driveState.currentSpeed = false, false, false, false, 0
speedText.Text = "000" return
end
-- HIGH POWER ACCELERATION SCALING
local absSp = math.abs(driveState.currentSpeed)
local fFactor = math.clamp(1 - (absSp / MAX_SPEED), 0.22, 1.0)
local rFactor = math.clamp(1 - (absSp / math.abs(MAX_REVERSE)), 0.35, 1.0)
if driveState.brake then
driveState.currentSpeed = driveState.currentSpeed > 0 and math.max(0, driveState.currentSpeed - BRAKE_FACTOR) or math.min(0, driveState.currentSpeed + BRAKE_FACTOR)
elseif driveState.forward and not driveState.engineKillOverride then
driveState.currentSpeed = math.min(MAX_SPEED, driveState.currentSpeed + (2.65 * fFactor))
elseif driveState.reverse and not driveState.engineKillOverride then
driveState.currentSpeed = math.max(MAX_REVERSE, driveState.currentSpeed - (1.45 * rFactor))
else
if driveState.currentSpeed > 0 then driveState.currentSpeed = math.max(0, driveState.currentSpeed - 0.75)
elseif driveState.currentSpeed < 0 then driveState.currentSpeed = math.min(0, driveState.currentSpeed + 0.75) end
end
-- SPEED-ADAPTIVE STEERING RATE HANDLING (Turning intensity accelerates in direct proportion to your current velocity)
local targetSteerInput = 0
if absSp > 0.1 then
local baselineAngle = 1.15
local scaleProgression = math.clamp(absSp / 45, 0.25, 1.65) -- Increases steering responsiveness as speed steps up
if driveState.left then
targetSteerInput = baselineAngle * scaleProgression
elseif driveState.right then
targetSteerInput = -baselineAngle * scaleProgression
end
end
currentSteerAngle = math.lerp(currentSteerAngle, targetSteerInput, math.clamp(BASE_STEER_SPEED * dt, 0, 1))
-- Master Front Bumper Axis Geometry
local frontAxleOffset = CFrame.new(0, 0, -6)
local nextCFrame = prim.CFrame * frontAxleOffset * CFrame.Angles(0, currentSteerAngle * dt, 0) * frontAxleOffset:Inverse() * CFrame.new(0, 0, -driveState.currentSpeed * dt)
local rayParams = RaycastParams.new()
rayParams.FilterDescendantsInstances = { VehicleModel, LocalPlayer.Character }
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local leftFrontPos = (nextCFrame * CFrame.new(-3.5, 4, -6)).Position
local rightFrontPos = (nextCFrame * CFrame.new(3.5, 4, -6)).Position
local rearCenterPos = (nextCFrame * CFrame.new(0, 4, 6)).Position
local rayLF = Workspace:Raycast(leftFrontPos, Vector3.new(0, -15, 0), rayParams)
local rayFR = Workspace:Raycast(rightFrontPos, Vector3.new(0, -15, 0), rayParams)
local rayRear = Workspace:Raycast(rearCenterPos, Vector3.new(0, -15, 0), rayParams)
if rayLF and rayFR and rayRear then
local pLF = rayLF.Position
local pFR = rayFR.Position
local pRear = rayRear.Position
local frontAxleCenter = (pLF + pFR) / 2
local lookDirection = (frontAxleCenter - pRear).Unit
local worldFlatRight = nextCFrame.RightVector
local cleanCorrectedUp = worldFlatRight:Cross(lookDirection).Unit
local groundTargetCFrame = CFrame.fromMatrix(
Vector3.new(nextCFrame.Position.X, frontAxleCenter.Y + 1.2, nextCFrame.Position.Z),
worldFlatRight,
cleanCorrectedUp,
-lookDirection
)
nextCFrame = prim.CFrame:Lerp(groundTargetCFrame, 0.20)
elseif rayLF or rayRear then
local fallbackResult = rayLF or rayRear
local norm = fallbackResult.Normal
local targetH = fallbackResult.Position.Y + 1.2
local fwd = nextCFrame.LookVector local rgt = fwd:Cross(norm).Unit local trueFwd = norm:Cross(rgt).Unit
local directTargetCFrame = CFrame.fromMatrix(Vector3.new(nextCFrame.Position.X, targetH, nextCFrame.Position.Z), rgt, norm, -trueFwd)
nextCFrame = prim.CFrame:Lerp(directTargetCFrame, 0.20)
end
prim.CFrame = nextCFrame
for part, origCFrame in pairs(OriginalCFrameStorage) do
if part and part.Parent and part ~= prim then
local airbagY = airbagsDeployed and -0.4 or 0
local flapY = flapsDeployed and -1.9 or 0
if flapsDeployed and airbagsDeployed then flapY = -1.5 end
local sideSpikeY = 0
if spikesDeployed then
sideSpikeY = airbagsDeployed and -3.1 or -3.5
elseif flapsDeployed then
sideSpikeY = airbagsDeployed and -1.5 or -1.9
end
local rearSpikeY = spikesDeployed and 2.3 or 0
local localOffset = Vector3.new(0, 0, 0)
local worldAirbagOffset = Vector3.new(0, airbagY, 0)
if isInsideWheelFolder(part) then worldAirbagOffset = Vector3.new(0, 0, 0) end
if part.Name == "LeftFlap" or part.Name == "LeftShield" or part.Name == "RightFlap" or part.Name == "RightShield" or part.Name == "FrontFlap" or part.Name == "Shield2" or part.Name == "FLI" or part.Name == "FRI" then
localOffset = Vector3.new(0, flapY, 0)
elseif part.Name == "LeftSpike" or part.Name == "RightSpike" then
localOffset = Vector3.new(0, -sideSpikeY, 0)
elseif part.Name == "BackSpike" then
localOffset = Vector3.new(0, rearSpikeY, 0)
end
part.CFrame = prim.CFrame * OriginalPrimaryCFrame:ToObjectSpace((origCFrame * CFrame.new(localOffset)) + worldAirbagOffset)
end
end
speedText.Text = string.format("%03d", math.abs(math.floor(driveState.currentSpeed)))
end)
