        for _, obj in ipairs(model) do if typeof(obj) == "Instance" then obj.Parent = workspace end end
    else model.Parent = workspace end
    currentVehicle = model

    local spawnCFrame = root.CFrame * CFrame.new(0, -1.8, -5)
    if model:IsA("Model") then model:PivotTo(spawnCFrame) else model.CFrame = spawnCFrame end

    local driverSeatPart = lookForSeat(model) or (model:IsA("BasePart") and model or model:FindFirstChildOfClass("BasePart"))
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored, part.CanCollide = true, true
            originalOffsets[part] = driverSeatPart.CFrame:ToObjectSpace(part.CFrame)
            currentAnimOffsets[part] = CFrame.identity
