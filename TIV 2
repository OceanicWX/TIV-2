    local model = nil
    if success and objects then
        if typeof(objects) == "Instance" then model = objects
        elseif typeof(objects) == "table" and #objects > 0 then model = objects end
    end
    if not model then
        local success2, model2 = pcall(function() return game:GetService("InsertService"):LoadAsset(18610130072) end)
        if success2 and model2 then model = model2:FindFirstChildOfClass("Model") or model2 end
    end
    if not model then return end

