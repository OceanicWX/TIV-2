local function tweenAirbags(directionLower)
local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local completedSignal = Instance.new("BindableEvent")
local activeTweens = 0
bodyLowered = directionLower playAudioClip("Airbags")
for _, part in ipairs(getVehicleDescendants()) do
if part:IsA("BasePart") and not isPartInWheelsGroup(part) then
local isAnimatedMovingPart = table.find({"LeftShield", "LeftFlap", "LeftSpike", "RightShield", "RightFlap", "RightSpike", "FrontField", "FrontFlap", "Shield2", "FRI", "FLI", "BackSpike"}, part.Name) ~= nil
local airbagOffset = directionLower and -0.4 or 0
local currentRot = part.CFrame - part.CFrame.Position
local baseCFrame = originalCFrames[part] or part.CFrame
local basePos = baseCFrame.Position
if part.Name == "LeftSpike" or part.Name == "RightSpike" then
if spikesRaised then basePos = (baseCFrame * CFrame.new(0, 3.2, 0)).Position end
elseif part.Name == "BackSpike" then
if spikesRaised then basePos = (baseCFrame * CFrame.new(0, 2.3, 0)).Position end
elseif isAnimatedMovingPart and shieldsLowered then
local offsetVal = -1.9 if part.Name == "LeftSpike" or part.Name == "RightSpike" then offsetVal = 1.9 end
basePos = (baseCFrame * CFrame.new(0, offsetVal, 0)).Position
end
local targetCFrame = CFrame.new(basePos + Vector3.new(0, airbagOffset, 0)) * currentRot
local tween = TweenService:Create(part, tweenInfo, {CFrame = targetCFrame}) activeTweens = activeTweens + 1
tween.Completed:Connect(function() activeTweens = activeTweens - 1 if activeTweens <= 0 then completedSignal:Fire() end end)
tween:Play()
end
end
if activeTweens == 0 then return end
completedSignal.Event:Wait() completedSignal:Destroy()
end
airbagsTool.Activated:Connect(function()
if not currentVehicle then spawnVehicle() return end
if isTweeningBody then return end isTweeningBody = true
task.spawn(function() if not bodyLowered then tweenAirbags(true) else tweenAirbags(false) end isTweeningBody = false end)
end)
