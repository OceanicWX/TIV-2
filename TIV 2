end

RunService.Heartbeat:Connect(function(dt)
	if not VehicleModel or not VehicleModel.Parent or not VehicleModel.PrimaryPart or not isSeated or not OriginalPrimaryCFrame then return end
	local prim = VehicleModel.PrimaryPart
	
	if isTweening then
		driveState.currentSpeed = 0
	else
		local absSp = math.abs(driveState.currentSpeed)
		local fFactor = math.clamp(1 - (absSp / MAX_SPEED), 0.15, 1.0)
		local rFactor = math.clamp(1 - (absSp / math.abs(MAX_REVERSE)), 0.25, 1.0)
		
		if driveState.brake then
			driveState.currentSpeed = driveState.currentSpeed > 0 and math.max(0, driveState.currentSpeed - BRAKE_FACTOR) or math.min(0, driveState.currentSpeed + BRAKE_FACTOR)
		elseif driveState.forward then
			driveState.currentSpeed = math.min(MAX_SPEED, driveState.currentSpeed + (1.15 * fFactor))
		elseif driveState.reverse then
			driveState.currentSpeed = math.max(MAX_REVERSE, driveState.currentSpeed - (0.65 * rFactor))
		else
			if driveState.currentSpeed > 0 then driveState.currentSpeed = math.max(0, driveState.currentSpeed - 0.45)
			elseif driveState.currentSpeed < 0 then driveState.currentSpeed = math.min(0, driveState.currentSpeed + 0.45) end
		end
	end
	
	local absSp = math.abs(driveState.currentSpeed)
	local sMod = math.clamp(1.0 - (absSp / MAX_SPEED) * 0.65, 0.38, 1.0)
	local turnAngle = 0
	if absSp > 0.1 and not isTweening then
		if driveState.left then turnAngle = 1.05 * sMod elseif driveState.right then turnAngle = -1.05 * sMod end
	end
	
	local nextCFrame = prim.CFrame * CFrame.Angles(0, turnAngle * dt, 0) * CFrame.new(0, 0, -driveState.currentSpeed * dt)
	local rayO = nextCFrame.Position + Vector3.new(0, 2, 0)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances, raycastParams.FilterType = { VehicleModel, LocalPlayer.Character }, Enum.RaycastFilterType.Exclude
	local res = Workspace:Raycast(rayO, Vector3.new(0, -12, 0), raycastParams)
	
	if res then
		local norm, pos = res.Normal, res.Position
		local fwd = nextCFrame.LookVector
		local rgt = fwd:Cross(norm).Unit
		nextCFrame = CFrame.fromMatrix(Vector3.new(nextCFrame.Position.X, pos.Y + 1.2, nextCFrame.Position.Z), rgt, norm, -norm:Cross(rgt).Unit)
	end
	prim.CFrame = nextCFrame
	
	local airbagY, flapY, sideSpikeY, rearSpikeY = getOffsets()
	for part, origCFrame in pairs(OriginalCFrameStorage) do
		if part and part.Parent and part ~= prim and not part:GetAttribute("IsTweening") then
			local localOffset = Vector3.zero
			local worldAirbagOffset = isInsideWheelFolder(part) and Vector3.zero or Vector3.new(0, airbagY, 0)
			
			if part.Name == "LeftFlap" or part.Name == "LeftShield" or part.Name == "RightFlap" or part.Name == "RightShield" or part.Name == "FrontFlap" or part.Name == "Shield2" or part.Name == "FLI" or part.Name == "FRI" then
				localOffset = Vector3.new(0, flapY, 0)
			elseif part.Name == "LeftSpike" or part.Name == "RightSpike" then
				localOffset = Vector3.new(0, -sideSpikeY, 0)
			elseif part.Name == "BackSpike" then
				localOffset = Vector3.new(0, rearSpikeY, 0)
			end
			
			local modifiedOrigCFrame = (origCFrame * CFrame.new(localOffset)) + worldAirbagOffset
			part.CFrame = prim.CFrame * OriginalPrimaryCFrame:ToObjectSpace(modifiedOrigCFrame)
		end
	end
	speedText.Text = string.format("%03d", math.abs(math.floor(driveState.currentSpeed)))
end)

local function runPipeline()
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	initializeVehicle(char)
	equipVehicleTool()
	equipSpikeController()
	equipCameraToggle()
	equipAirbagsTool()
	equipSitTeleportTool()
end
runPipeline()
