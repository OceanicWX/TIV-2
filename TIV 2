local function equipSpikeController()
	local tool = Instance.new("Tool")
	tool.Name, tool.RequiresHandle = "Spike Controller", false

	tool.Activated:Connect(function()
		if isTweening or not VehicleModel then return end
		isTweening = true
		stopDriving()
		spikesDeployed = not spikesDeployed
		local sideSpikeDur, rearSpikeDur = getSoundDuration("SideSpikes"), getSoundDuration("RearSpike")

		if spikesDeployed then
			playAudio("SideSpikes")
			tweenComponentToAbsoluteState("LeftSpike", sideSpikeDur)
			tweenComponentToAbsoluteState("RightSpike", sideSpikeDur)
			task.wait(sideSpikeDur)
			playAudio("RearSpike")
			tweenComponentToAbsoluteState("BackSpike", rearSpikeDur)
			task.wait(rearSpikeDur)
		else
			playAudio("RearSpike")
			tweenComponentToAbsoluteState("BackSpike", rearSpikeDur)
			task.wait(rearSpikeDur)
			playAudio("SideSpikes")
			tweenComponentToAbsoluteState("LeftSpike", sideSpikeDur)
			tweenComponentToAbsoluteState("RightSpike", sideSpikeDur)
			task.wait(sideSpikeDur)
		end
		isTweening = false
	end)
	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
end

local function equipCameraToggle()
	local tool = Instance.new("Tool")
	tool.Name, tool.RequiresHandle = "Turret Camera", false
	local stateActive, cancelDeactivation = false, false

	local function resetCam()
		local camera, char = Workspace.CurrentCamera, LocalPlayer.Character
		if camera and char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then camera.CameraSubject, camera.CameraType = hum, Enum.CameraType.Custom end
		end
	end

	tool.Activated:Connect(function()
		local camera = Workspace.CurrentCamera
		if not camera or not VehicleModel then return end
		stateActive = not stateActive

		if stateActive then
			cancelDeactivation = true
			local camBlocks = VehicleModel:FindFirstChild("Cam", true)
			if camBlocks and camBlocks:IsA("BasePart") then
				camera.CameraSubject, camera.CameraType = camBlocks, Enum.CameraType.Custom
			end
		else
			cancelDeactivation = false
			task.delay(0.15, function() if not cancelDeactivation then resetCam() end end)
		end
	end)
	tool.Unequipped:Connect(function() cancelDeactivation = true end)
	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
end

local function equipAirbagsTool()
	local tool = Instance.new("Tool")
	tool.Name, tool.RequiresHandle = "Airbags Tool", false
	
	tool.Activated:Connect(function()
		if isTweening or not VehicleModel then return end
		isTweening = true
		stopDriving()
		airbagsDeployed = not airbagsDeployed
		playAudio("Airbags")
		local airbagDur = getSoundDuration("Airbags")
		applyAbsoluteVehicleState(airbagDur)
		task.wait(airbagDur)
		isTweening = false
	end)
	tool.Parent = LocalPlayer:FindFirstChildOfClass("Backpack")
end

local function equipSitTeleportTool()
