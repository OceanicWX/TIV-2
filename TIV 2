        btnDeploy.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        btnDeploy.TextColor3 = Color3.fromRGB(100, 100, 100)
        btnDeploy.Active = false
        btnDeploy.Selectable = false

        local btnHideUI = createSleekButton("HIDE UI", UDim2.new(0, 0, 0, 0), UDim2.new(0, 90, 1, 0), persistentPanel)
        btnHideUI.TextSize = 14
        local btnEngineToggle = createSleekButton("ENG ON", UDim2.new(0, 100, 0, 0), UDim2.new(0, 90, 1, 0), persistentPanel)
        btnEngineToggle.TextSize = 14
        btnEngineToggle.BackgroundColor3 = Color3.fromRGB(20, 100, 20)

        local globalUIHidden = false
        local engineKillOverride = false
        local hiddenGuisCache = {}

        btnHideUI.MouseButton1Click:Connect(function()
            globalUIHidden = not globalUIHidden
            btnHideUI.Text = globalUIHidden and "SHOW UI" or "HIDE UI"
            if globalUIHidden then
                for _, gui in ipairs(PlayerGui:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui ~= persistentGui and gui ~= screenGui and gui.Enabled == true then
                        hiddenGuisCache[gui] = true
                        gui.Enabled = false
                    end
                end
                mainUIFrame.Visible = false
            else
                for gui, _ in pairs(hiddenGuisCache) do
                    if gui and gui.Parent then gui.Enabled = true end
                end
                table.clear(hiddenGuisCache)
                mainUIFrame.Visible = true
            end
        end)

        btnEngineToggle.MouseButton1Click:Connect(function()
            engineKillOverride = not engineKillOverride
            if engineKillOverride then
                btnEngineToggle.Text, btnEngineToggle.BackgroundColor3 = "ENG OFF", Color3.fromRGB(100, 20, 20)
                driveStateFlags.forward, driveStateFlags.reverse, driveStateFlags.left, driveStateFlags.right, driveStateFlags.brake, driveStateFlags.currentSpeed = false, false, false, false, false, 0
                stopEng()
            else
                btnEngineToggle.Text, btnEngineToggle.BackgroundColor3 = "ENG ON", Color3.fromRGB(20, 100, 20)
                if isSeated then startEng() end
            end
end)
local function bindDriveInput(btn, flag)
btn.InputBegan:Connect(function(input)
if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not engineKillOverride then
if flag == "forward" then driveStateFlags.reverse = false elseif flag == "reverse" then driveStateFlags.forward = false end
driveStateFlags[flag] = true btn.BackgroundTransparency = 0.1
end
end)
btn.InputEnded:Connect(function(input)
if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
driveStateFlags[flag] = false btn.BackgroundTransparency = 0.4
end
end)
end
bindDriveInput(btnForward, "forward")
bindDriveInput(btnReverse, "reverse")
bindDriveInput(btnLeft, "left")
bindDriveInput(btnRight, "right")
bindDriveInput(btnBrake, "brake")
RunService.Heartbeat:Connect(function(dt)
if not model or not model.Parent then return end
if isSeated then
if screenGui and not screenGui.Enabled then screenGui.Enabled = true end
if persistentGui and not persistentGui.Enabled then persistentGui.Enabled = true end
else
if screenGui and screenGui.Enabled then screenGui.Enabled = false end
if persistentGui and persistentGui.Enabled then persistentGui.Enabled = false end
driveStateFlags.forward, driveStateFlags.reverse, driveStateFlags.left, driveStateFlags.right, driveStateFlags.brake, driveStateFlags.currentSpeed = false, false, false, false, false, 0
-- Force continuous seat alignment even when player is unseated
if driverSeatPart and targetSeat then
targetSeat.CFrame = driverSeatPart.CFrame * CFrame.new(0, -0.3, 0)
end
return
end
local maxSpeed = 75
local maxReverse = -28
local accelFactor = 45 * dt
local brakeFactor = 120 * dt
local frictionFactor = 20 * dt
if driveStateFlags.brake then
if driveStateFlags.currentSpeed > 0 then driveStateFlags.currentSpeed = math.max(0, driveStateFlags.currentSpeed - brakeFactor)
else driveStateFlags.currentSpeed = math.min(0, driveStateFlags.currentSpeed + brakeFactor) end
elseif driveStateFlags.forward and not engineKillOverride then
driveStateFlags.currentSpeed = math.min(maxSpeed, driveStateFlags.currentSpeed + accelFactor)
elseif driveStateFlags.reverse and not engineKillOverride then
driveStateFlags.currentSpeed = math.max(maxReverse, driveStateFlags.currentSpeed - accelFactor)
else
if driveStateFlags.currentSpeed > 0 then driveStateFlags.currentSpeed = math.max(0, driveStateFlags.currentSpeed - frictionFactor)
elseif driveStateFlags.currentSpeed < 0 then driveStateFlags.currentSpeed = math.min(0, driveStateFlags.currentSpeed + frictionFactor) end
end
local turnSpeed = 0
if math.abs(driveStateFlags.currentSpeed) > 1 then
if driveStateFlags.left then turnSpeed = 1.6 * dt elseif driveStateFlags.right then turnSpeed = -1.6 * dt end
if driveStateFlags.currentSpeed < 0 then turnSpeed = -turnSpeed end
end
-- Drive system fix: Pure kinematic parent layout update via Model:PivotTo()
local modelCFrame = model:GetPivot()
local displacementVector = modelCFrame.LookVector * (driveStateFlags.currentSpeed * dt)
local rotationMatrix = CFrame.fromAxisAngle(Vector3.new(0, 1, 0), turnSpeed)
local finalCFrame = CFrame.new(modelCFrame.Position + displacementVector) * modelCFrame.Rotation * rotationMatrix
model:PivotTo(finalCFrame)
-- Airbags alignment fix: Calculate directly from driverSeatPart world space so it matches airbag displacement frames instantly
if driverSeatPart and targetSeat then
targetSeat.CFrame = driverSeatPart.CFrame * CFrame.new(0, -0.3, 0)
end
if speedText then speedText.Text = string.format("%03d", math.abs(math.floor(driveStateFlags.currentSpeed))) end
end)
end
end
local function findCameraPart()
for _, part in ipairs(getVehicleDescendants()) do if part:IsA("BasePart") and part.Name == "Cam" then return part end end
return nil
end
local function isPartInWheelsGroup(part)
local current = part.Parent
while current and current ~= workspace do
if current.Name == "Wheels" or current.Name == "wheels" then return true end
current = current.Parent
end
return false
end
