local function tweenSpikeGroup(partNames, directionRaise, soundKeyToPlay, customDuration)
if soundKeyToPlay then playAudioClip(soundKeyToPlay) end
local duration, elapsed, stepConnection = customDuration or 3, 0, nil
stepConnection = RunService.Heartbeat:Connect(function(dt)
elapsed = elapsed + dt
local alpha = math.clamp(elapsed / duration, 0, 1)
local ease = TweenService:GetValue(alpha, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
for _, part in ipairs(getVehicleDescendants()) do
if part:IsA("BasePart") and table.find(partNames, part.Name) then
local targetOffset = directionRaise and ((part.Name == "BackSpike") and 2.3 or 3.2) or 0
local targetLocalFrame = CFrame.new(0, targetOffset * ease, 0)
if bodyLowered then targetLocalFrame = CFrame.new(0, -0.4, 0) * targetLocalFrame end
currentAnimOffsets[part] = targetLocalFrame
end
end
if alpha >= 1 then stepConnection:Disconnect() end
end)
end
